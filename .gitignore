# ============================================================
# 依赖
# ============================================================
node_modules/
.pnpm-store/
.yarn/

# ============================================================
# 构建产物
# ============================================================
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# 后端 OpenAPI 快照由 tools/export_openapi.py 现场生成，不把旧快照带入提交
源码/backend/openapi.json

# ============================================================
# 环境变量 —— 密钥绝不入库
# 赛题硬性要求：API密钥等敏感信息不得出现在公开仓库中，须通过环境变量方式配置
# 保留 .env.example 作为模板
# ============================================================
.env
.env.local
.env.*.local
!.env.example

# ============================================================
# 前端 Vue 迁移的本机对比备份，不入库
源码/web-baseline-*/

# 运行时数据（生成的软件包、会话工作区、本地数据库）
# ============================================================
*.db
*.db-journal
*.sqlite
*.sqlite3
data/
workspace/
workbench/
artifacts/

# ============================================================
# 研究资料：第三方抓取的原始文档，非本项目原创，不入库
# ============================================================
.research/

# ============================================================
# 编辑器 / 系统
# ------------------------------------------------------------
# .vscode 下只提交「项目约定」类的文件，个人偏好不入库：
#   extensions.json —— 推荐插件，新同学打开就会有安装提示
#   settings.json   —— 保存即格式化、使用工程自带的 TypeScript 版本
# 个人的调试配置、任务配置请放进 *.local.json 或自行忽略
# ============================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 日志
# ============================================================
*.log
logs/
npm-debug.log*
yarn-error.log*

# ============================================================
# 临时文件
# ============================================================
tmp/
temp/
*.tmp
*.bak

# ============================================================
# Python（backend/）
# ============================================================
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.import_linter_cache/
*.egg-info/
backend/.env

# artifacts/ 是运行产物目录，但 backend 里有一个同名的源码包，别一起忽略
!源码/backend/app/features/artifacts/

# workbench/ 是运行时产物目录名，但 web 下有一个同名源码目录，别一起忽略
!源码/web/workbench/

# workspace/ 是运行时产物目录名，但 web/assist 下有一个同名源码目录，别一起忽略
!源码/web/assist/workspace/

# build/ 是构建产物目录名，但 backend 有一个同名源码包，别一起忽略
!源码/backend/app/api/pipeline/stages/build/

# ============================================================
# 已废弃 / 未入库的大件
# ------------------------------------------------------------
# Next.js 旧前端（945MB，2.7 万文件），只作本地留档，绝不入库
源码/frontend/
# 设计参考图与临时产出
.creative-design/
design-preview/

# v2 工作台 / 辅助工作台：源码目录同名，不能被运行时目录规则误伤
!源码/web-vue/src/workbench/
!源码/web-vue/src/workbench/**
!源码/web-vue/src/workspace/
!源码/web-vue/src/workspace/**
!源码/web/vue-dist/workbench/
!源码/web/vue-dist/workbench/**
!源码/web/vue-dist/assist/workspace/
