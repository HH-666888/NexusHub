{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus —— 一个网页里的软件工厂：从一句话到可交付的软件包",
  "scripts": {
    "predev": "node scripts/ensure-data-dir.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-data-dir.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/ensure-data-dir.mjs && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:inspect": "tsx src/scripts/inspect-db.ts",
    "smoke:auth": "tsx src/scripts/smoke-auth.ts",
    "e2e:auth": "tsx src/scripts/e2e-auth.ts",
    "e2e:run": "tsx src/scripts/e2e-run.ts",
    "e2e:generate": "tsx src/scripts/e2e-generate.ts",
    "e2e:settings": "tsx src/scripts/e2e-settings.ts",
    "e2e:canvas": "tsx src/scripts/e2e-canvas.ts",
    "demo:seed": "tsx src/scripts/demo-seed.ts",
    "demo:token": "tsx src/scripts/demo-token.ts",
    "probe": "tsx src/scripts/probe-capability.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
