# ============================================================
# 环境变量模板
# ------------------------------------------------------------
# 用法：复制本文件为 .env.local，填入真实值。
# .env.local 已被 .gitignore 忽略，不会进入公开仓库。
#
# 赛题要求：API密钥等敏感信息不得出现在公开仓库中，
#          须通过环境变量方式配置。
# ============================================================

# ---------- 模型接口 ----------
# DeepSeek 接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 你的密钥，形如 sk-xxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=

# 使用的模型名（当前有效：deepseek-flash / deepseek-v4-pro）
MODEL_EXECUTE=deepseek-flash
MODEL_DECIDE=deepseek-flash

# ---------- 运行参数 ----------
# 沙箱单容器资源上限

# 单次运行的成本上限（元），超过后自动降档
RUN_COST_LIMIT_CNY=5

# 并行构建的并发上限（同时在飞的模块构建调用数）。
# 第四道工序按模块并行，3 是保守起点；设 1 退回串行。
# 留空 / 不写 = 用默认值 3（见 src/config/env.ts 与 src/core/domain/module-build.ts）
MAX_PARALLEL_BUILD=3

# ---------- 数据 ----------
# 状态库位置（SQLite）
DATABASE_PATH=./data/nexus.db
# 运行工作区根目录
WORKSPACE_ROOT=./data/workspace

# ---------- 全栈运行时（可选）----------
# off = 只生成单文件网页（默认，旧流程）
# on  = 生成 数据库 + 后端 + 前端，并调后端把服务跑起来
FULLSTACK_MODE=off
# 后端运行时服务地址（Next 服务端调用，浏览器不直连）
RUNTIME_URL=http://127.0.0.1:8000
# 内部调用口令：后端与 Next 两侧必须一致，否则 401
INTERNAL_TOKEN=
