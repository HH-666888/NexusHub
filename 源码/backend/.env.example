# 复制成 .env 后按需修改；真实密钥不要提交
# 数据库（容器内主机名是 mysql，本机开发是 127.0.0.1）
DATABASE_URL=mysql+pymysql://nexus:nexus@127.0.0.1:3306/nexus?charset=utf8mb4

# 模型
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
MODEL_DECIDE=deepseek-chat
MODEL_EXECUTE=deepseek-chat

# 预算与并行
RUN_COST_LIMIT_CNY=5
MAX_PARALLEL_BUILD=3

# 语料目录（相对 backend/）
PLAYBOOK_DIR=content/playbook

# 同源部署留空；只有本地两端不同端口调试时才填前端地址
ALLOWED_ORIGIN=