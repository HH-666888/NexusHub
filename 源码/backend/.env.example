# 复制为 .env 后按需填写。任何真实密钥都不要提交。
# 最小可跑集合：DATABASE_URL + DEEPSEEK_API_KEY，其余留默认即可。

# ---------- 数据库 ----------
# 契约要求 utf8mb4 与 UTC；容器内主机名是 mysql，本机开发是 127.0.0.1
DATABASE_URL=mysql+pymysql://nexus:nexus@127.0.0.1:3306/nexus?charset=utf8mb4

# ---------- 模型 ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# 按阶段配置模型名；当前版本两阶段都用 deepseek-chat
MODEL_DECIDE=deepseek-chat
MODEL_EXECUTE=deepseek-chat
# 单次运行的费用上限（元），超出即停止
RUN_COST_LIMIT_CNY=5

# ---------- 目录 ----------
# 语料与技能说明都相对 backend/ 根目录
PLAYBOOK_DIR=../RAG-knowledge
SKILL_DIR=../skills/software-development

# ---------- 会话 ----------
# 本地用 http 调试必须为 false，否则浏览器不回传 cookie，表现为登录后立刻掉线
COOKIE_SECURE=false
# 同源部署留空；只有前后端不同端口调试时才填前端地址
ALLOWED_ORIGIN=

# ---------- 流水线行为 ----------
# 模型录制回放：off 直连 | record 存 cassette | replay 读 backend/data/cassettes
RECORD_MODE=off
# 自动测试失败后回第 3 道工序重修的轮数上限
MAX_LOOPBACK=2
# 人工门禁单次最多提问数/轮数，0 表示不限
ASK_MAX_QUESTIONS=0
ASK_MAX_ROUNDS=0
# AI 记忆每天最多写入条数
MEMORY_DAILY_LIMIT=3

# ---------- 全栈运行时 ----------
# 建库用的供给账号：只有 CREATE/DROP DATABASE，见 database/schema/002_provisioner.sql
MYSQL_PROVISIONER_URL=mysql+pymysql://nexus_provisioner:<密码>@127.0.0.1:3306/?charset=utf8mb4
# 产物代码用的账号：只对 nexus_run_% 有权限；主机写 host.docker.internal，
# 注入容器时它指向宿主，宿主侧验证时会换回 127.0.0.1
MYSQL_PRODUCT_URL=mysql+pymysql://nexus_product:<密码>@host.docker.internal:3306
# 内部调用口令：与前端 INTERNAL_TOKEN 必须一致，否则 401；留空则运行时接口 503
INTERNAL_TOKEN=
# 产物工作区：与前端 WORKSPACE_ROOT 指向同一个绝对目录（两边读写同一批文件）
RUNTIME_WORKSPACE_DIR=./data/workspace
# 运行器：docker（有隔离）| process（没有 Docker 的开发机，把产物当本机 uvicorn 跑）
RUNTIME_RUNNER=process

# ---------- 仅 docker-compose 读取 ----------
MAX_PARALLEL_BUILD=3
