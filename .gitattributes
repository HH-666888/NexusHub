# 统一换行符为 LF，避免 Windows / Linux 之间产生无意义的整文件差异
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary

# lock 文件在 diff 中折叠，减少噪音
package-lock.json -diff linguist-generated

# Windows 批处理必须是 CRLF，且不能被上面的 * 规则覆盖
*.bat text eol=crlf
*.cmd text eol=crlf
